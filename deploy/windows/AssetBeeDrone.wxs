<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

	<Package
		Name="AssetBee Drone"
		Manufacturer="AssetBee"
		Version="$(var.Version)"
		UpgradeCode="A7E3C2B1-4D5F-6A78-9B0C-1D2E3F4A5B6C"
		Scope="perMachine"
		Language="1033">

		<!-- ARP metadata helps enterprise allowlists and reduces "unknown publisher" noise. -->
		<Property
			Id="ARPCOMMENTS"
			Value="AssetBee device inventory agent." />
		<Property
			Id="ARPCONTACT"
			Value="AssetBee" />

		<Upgrade Id="A7E3C2B1-4D5F-6A78-9B0C-1D2E3F4A5B6C">

			<UpgradeVersion
				Property="WIX_UPGRADE_DETECTED"
				Minimum="0.0.0"
				Maximum="$(var.Version)"
				IncludeMinimum="yes"
				IncludeMaximum="no" />

			<!--
				Version 1.0.0 required ENDPOINT even while RemoveExistingProducts was
				uninstalling it. Detect that release separately so the full UI can
				remove it before the new install transaction begins.
			-->
			<UpgradeVersion
				Property="LEGACY_UPGRADE_DETECTED"
				Minimum="1.0.0"
				Maximum="1.0.0"
				IncludeMinimum="yes"
				IncludeMaximum="yes"
				OnlyDetect="yes" />

			<UpgradeVersion
				Property="SAME_VERSION_PRODUCT"
				Minimum="$(var.Version)"
				Maximum="$(var.Version)"
				IncludeMinimum="yes"
				IncludeMaximum="yes" />

			<UpgradeVersion
				Property="WIX_DOWNGRADE_DETECTED"
				Minimum="$(var.Version)"
				IncludeMinimum="no"
				OnlyDetect="yes" />

		</Upgrade>

		<!-- Only prevent actual downgrades. -->
		<Launch
			Condition="NOT WIX_DOWNGRADE_DETECTED"
			Message="A newer version of AssetBee Drone is already installed." />

		<MediaTemplate EmbedCab="yes" />

		<WixVariable
			Id="WixUILicenseRtf"
			Value="$(var.SourceDir)\License.rtf" />

		<!-- Runtime configuration -->
		<Property Id="ENDPOINT" Secure="yes" />
		<Property Id="BEARERTOKEN" Secure="yes" Hidden="yes" />
		<Property Id="APIKEY" Secure="yes" Hidden="yes" />
		<Property Id="PENDINGCONFIGPATH" Secure="yes" Hidden="yes" />
		<Property Id="UNINSTALL_PRODUCTS" Secure="yes" Hidden="yes" />
		<Property Id="UNINSTALL_UI" Secure="yes" Hidden="yes" Value="quiet" />

		<!-- Existing configuration -->
		<Property Id="BT_EXISTING" Secure="yes" Hidden="yes" />
		<Property Id="AK_EXISTING" Secure="yes" Hidden="yes" />

		<Property Id="EP_HKLM" Secure="yes">
			<RegistrySearch
				Id="ExistingEndpointHklm"
				Root="HKLM"
				Key="SOFTWARE\AssetBee\Drone"
				Name="Endpoint"
				Type="raw" />
		</Property>

		<Property Id="BT_HKLM" Secure="yes" Hidden="yes">
			<RegistrySearch
				Id="ExistingBearerHklm"
				Root="HKLM"
				Key="SOFTWARE\AssetBee\Drone"
				Name="BearerToken"
				Type="raw" />
		</Property>

		<Property Id="AK_HKLM" Secure="yes" Hidden="yes">
			<RegistrySearch
				Id="ExistingApiKeyHklm"
				Root="HKLM"
				Key="SOFTWARE\AssetBee\Drone"
				Name="ApiKey"
				Type="raw" />
		</Property>

		<Property Id="EP_HKCU" Secure="yes">
			<RegistrySearch
				Id="ExistingEndpointHkcu"
				Root="HKCU"
				Key="SOFTWARE\AssetBee\Drone"
				Name="Endpoint"
				Type="raw" />
		</Property>

		<Property Id="BT_HKCU" Secure="yes" Hidden="yes">
			<RegistrySearch
				Id="ExistingBearerHkcu"
				Root="HKCU"
				Key="SOFTWARE\AssetBee\Drone"
				Name="BearerToken"
				Type="raw" />
		</Property>

		<Property Id="AK_HKCU" Secure="yes" Hidden="yes">
			<RegistrySearch
				Id="ExistingApiKeyHkcu"
				Root="HKCU"
				Key="SOFTWARE\AssetBee\Drone"
				Name="ApiKey"
				Type="raw" />
		</Property>

		<Feature
			Id="Main"
			Title="AssetBee Drone"
			Level="1">

			<ComponentGroupRef Id="ProductComponents" />

		</Feature>

		<StandardDirectory Id="ProgramFiles64Folder">

			<Directory
				Id="AssetBeeFolder"
				Name="AssetBee">

				<Directory
					Id="INSTALLFOLDER"
					Name="Drone" />

			</Directory>

		</StandardDirectory>

		<!-- Native helper for MSI custom actions (no PowerShell dropper chain). -->
		<Binary
			Id="AssetBeeMsiHelper"
			SourceFile="$(var.HelperPath)" />

		<ComponentGroup
			Id="ProductComponents"
			Directory="INSTALLFOLDER">

			<Component
				Id="InstallFolderAcl"
				Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

				<CreateFolder>
					<util:PermissionEx
						User="SYSTEM"
						GenericAll="yes" />

					<util:PermissionEx
						User="Administrators"
						GenericAll="yes" />

					<util:PermissionEx
						User="Users"
						GenericRead="yes"
						GenericExecute="yes" />
				</CreateFolder>

				<RemoveFile
					Id="RemoveAppSettings"
					Name="appsettings.json"
					On="uninstall" />

				<RemoveRegistryKey
					Root="HKLM"
					Key="SOFTWARE\AssetBee\Drone"
					Action="removeOnUninstall" />

				<RemoveRegistryKey
					Root="HKCU"
					Key="SOFTWARE\AssetBee\Drone"
					Action="removeOnUninstall" />

			</Component>

			<Component
				Id="DroneBinary"
				Guid="B1C2D3E4-F5A6-7890-1234-56789ABCDEF0">

				<File
					Id="DroneExe"
					Source="$(var.PublishDir)\AssetBee.Drone.exe"
					KeyPath="yes" />

				<ServiceInstall
					Id="AssetBeeDroneService"
					Name="AssetBeeDrone"
					DisplayName="AssetBee Drone"
					Description="Collects and securely reports device inventory."
					Type="ownProcess"
					Start="auto"
					Account="LocalSystem"
					ErrorControl="normal"
					Vital="yes" />

				<ServiceControl
					Id="StartAssetBeeDroneService"
					Name="AssetBeeDrone"
					Start="install"
					Stop="both"
					Remove="uninstall"
					Wait="yes" />

				<util:ServiceConfig
					ServiceName="AssetBeeDrone"
					FirstFailureActionType="restart"
					SecondFailureActionType="restart"
					ThirdFailureActionType="restart"
					RestartServiceDelayInSeconds="15"
					ResetPeriodInDays="1" />

			</Component>

			<Component
				Id="TrayBinary"
				Guid="E4F5A6B7-C8D9-0123-4567-89ABCDEF0123">

				<File
					Id="TrayExe"
					Source="$(var.PublishDir)\AssetBee.Drone.Tray.exe"
					KeyPath="yes" />

				<RegistryValue
					Root="HKLM"
					Key="Software\Microsoft\Windows\CurrentVersion\Run"
					Name="AssetBeeDroneTray"
					Type="string"
					Value="&quot;[#TrayExe]&quot;" />

			</Component>

		</ComponentGroup>

		<UIRef Id="AssetBeeDroneUI" />

		<!-- Seed registry from existing appsettings.json before AppSearch. -->
		<CustomAction
			Id="LoadExistingSettings"
			BinaryRef="AssetBeeMsiHelper"
			ExeCommand="load-existing"
			Execute="immediate"
			Impersonate="yes"
			Return="ignore" />

		<CustomAction
			Id="PreserveExistingSettings"
			BinaryRef="AssetBeeMsiHelper"
			ExeCommand="preserve"
			Execute="immediate"
			Impersonate="no"
			Return="ignore" />

		<CustomAction
			Id="SavePendingSettings"
			BinaryRef="AssetBeeMsiHelper"
			ExeCommand="save-pending --pending &quot;[PENDINGCONFIGPATH]&quot; --endpoint &quot;[ENDPOINT]&quot; --bearer &quot;[BEARERTOKEN]&quot; --api &quot;[APIKEY]&quot;"
			Execute="immediate"
			Impersonate="yes"
			Return="check" />

		<CustomAction
			Id="UninstallRelatedProducts"
			BinaryRef="AssetBeeMsiHelper"
			ExeCommand="uninstall-related --products &quot;[UNINSTALL_PRODUCTS]&quot; --endpoint &quot;[ENDPOINT]&quot; --ui &quot;[UNINSTALL_UI]&quot;"
			Execute="immediate"
			Impersonate="no"
			Return="check" />

		<!-- Copy AppSearch values into the primary MSI properties -->

		<CustomAction
			Id="SetEndpointFromHklm"
			Property="ENDPOINT"
			Value="[EP_HKLM]" />

		<CustomAction
			Id="SetEndpointFromHkcu"
			Property="ENDPOINT"
			Value="[EP_HKCU]" />

		<CustomAction
			Id="SetBearerExistingFromHklm"
			Property="BT_EXISTING"
			Value="[BT_HKLM]" />

		<CustomAction
			Id="SetBearerExistingFromHkcu"
			Property="BT_EXISTING"
			Value="[BT_HKCU]" />

		<CustomAction
			Id="SetApiKeyExistingFromHklm"
			Property="AK_EXISTING"
			Value="[AK_HKLM]" />

		<CustomAction
			Id="SetApiKeyExistingFromHkcu"
			Property="AK_EXISTING"
			Value="[AK_HKCU]" />

		<CustomAction
			Id="RestoreBearerOnly"
			Property="BEARERTOKEN"
			Value="[BT_EXISTING]" />

		<CustomAction
			Id="RestoreApiKeyOnly"
			Property="APIKEY"
			Value="[AK_EXISTING]" />

		<CustomAction
			Id="RestoreBearerPrefer"
			Property="BEARERTOKEN"
			Value="[BT_EXISTING]" />

		<SetProperty
			Id="PENDINGCONFIGPATH"
			Action="SetPendingConfigPathUI"
			Sequence="ui"
			Before="LoadExistingSettings"
			Condition="NOT REMOVE"
			Value="[WindowsFolder]Temp\AssetBee-Drone-[ProductCode]-pending.json" />

		<SetProperty
			Id="PENDINGCONFIGPATH"
			Action="SetPendingConfigPathExec"
			Sequence="execute"
			Before="LoadExistingSettings"
			Condition="NOT REMOVE AND NOT PENDINGCONFIGPATH"
			Value="[WindowsFolder]Temp\AssetBee-Drone-[ProductCode]-pending.json" />

		<!-- Deferred config write: properties are formatted when the action is scheduled. -->
		<CustomAction
			Id="WriteAppSettings"
			BinaryRef="AssetBeeMsiHelper"
			ExeCommand="write-settings --endpoint &quot;[ENDPOINT]&quot; --bearer &quot;[BEARERTOKEN]&quot; --api &quot;[APIKEY]&quot; --pending &quot;[PENDINGCONFIGPATH]&quot; --install &quot;[INSTALLFOLDER].&quot;"
			Execute="deferred"
			Impersonate="no"
			HideTarget="yes"
			Return="check" />

		<CustomAction
			Id="LaunchTray"
			FileRef="TrayExe"
			ExeCommand=""
			Execute="immediate"
			Impersonate="yes"
			Return="asyncNoWait" />

		<InstallUISequence>

			<Custom
				Action="LoadExistingSettings"
				Before="AppSearch"
				Condition="NOT REMOVE" />

			<Custom
				Action="SetEndpointFromHklm"
				After="AppSearch"
				Condition="NOT ENDPOINT AND EP_HKLM" />

			<Custom
				Action="SetEndpointFromHkcu"
				After="SetEndpointFromHklm"
				Condition="NOT ENDPOINT AND EP_HKCU" />

			<Custom
				Action="SetBearerExistingFromHklm"
				After="AppSearch"
				Condition="NOT BT_EXISTING AND BT_HKLM" />

			<Custom
				Action="SetBearerExistingFromHkcu"
				After="SetBearerExistingFromHklm"
				Condition="NOT BT_EXISTING AND BT_HKCU" />

			<Custom
				Action="SetApiKeyExistingFromHklm"
				After="AppSearch"
				Condition="NOT AK_EXISTING AND AK_HKLM" />

			<Custom
				Action="SetApiKeyExistingFromHkcu"
				After="SetApiKeyExistingFromHklm"
				Condition="NOT AK_EXISTING AND AK_HKCU" />

			<Custom
				Action="RestoreBearerOnly"
				After="SetApiKeyExistingFromHkcu"
				Condition="NOT BEARERTOKEN AND NOT APIKEY AND BT_EXISTING AND NOT AK_EXISTING AND NOT REMOVE" />

			<Custom
				Action="RestoreApiKeyOnly"
				After="RestoreBearerOnly"
				Condition="NOT BEARERTOKEN AND NOT APIKEY AND AK_EXISTING AND NOT REMOVE" />

			<Custom
				Action="RestoreBearerPrefer"
				After="RestoreApiKeyOnly"
				Condition="NOT BEARERTOKEN AND NOT APIKEY AND BT_EXISTING AND NOT REMOVE" />

		</InstallUISequence>

		<InstallExecuteSequence>

			<Custom
				Action="LoadExistingSettings"
				Before="AppSearch"
				Condition="NOT REMOVE" />

			<Custom
				Action="SetEndpointFromHklm"
				After="AppSearch"
				Condition="NOT ENDPOINT AND EP_HKLM" />

			<Custom
				Action="SetEndpointFromHkcu"
				After="SetEndpointFromHklm"
				Condition="NOT ENDPOINT AND EP_HKCU" />

			<Custom
				Action="SetBearerExistingFromHklm"
				After="AppSearch"
				Condition="NOT BT_EXISTING AND BT_HKLM" />

			<Custom
				Action="SetBearerExistingFromHkcu"
				After="SetBearerExistingFromHklm"
				Condition="NOT BT_EXISTING AND BT_HKCU" />

			<Custom
				Action="SetApiKeyExistingFromHklm"
				After="AppSearch"
				Condition="NOT AK_EXISTING AND AK_HKLM" />

			<Custom
				Action="SetApiKeyExistingFromHkcu"
				After="SetApiKeyExistingFromHklm"
				Condition="NOT AK_EXISTING AND AK_HKCU" />

			<Custom
				Action="RestoreBearerOnly"
				After="SetApiKeyExistingFromHkcu"
				Condition="NOT BEARERTOKEN AND NOT APIKEY AND BT_EXISTING AND NOT AK_EXISTING AND NOT REMOVE" />

			<Custom
				Action="RestoreApiKeyOnly"
				After="RestoreBearerOnly"
				Condition="NOT BEARERTOKEN AND NOT APIKEY AND AK_EXISTING AND NOT REMOVE" />

			<Custom
				Action="RestoreBearerPrefer"
				After="RestoreApiKeyOnly"
				Condition="NOT BEARERTOKEN AND NOT APIKEY AND BT_EXISTING AND NOT REMOVE" />

			<Custom
				Action="PreserveExistingSettings"
				After="InstallInitialize"
				Condition="(WIX_UPGRADE_DETECTED OR SAME_VERSION_PRODUCT) AND NOT REMOVE" />

			<RemoveExistingProducts
				After="PreserveExistingSettings" />

			<Custom
				Action="WriteAppSettings"
				Before="StartServices"
				Condition="NOT REMOVE" />

			<Custom
				Action="LaunchTray"
				After="InstallFinalize"
				Condition="NOT REMOVE" />

		</InstallExecuteSequence>

	</Package>

</Wix>
