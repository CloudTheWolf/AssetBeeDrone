<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

	<Package
		Name="AssetBee Drone"
		Manufacturer="AssetBee"
		Version="$(var.Version)"
		UpgradeCode="A7E3C2B1-4D5F-6A78-9B0C-1D2E3F4A5B6C"
		Scope="perMachine"
		Language="1033">

		<Upgrade Id="A7E3C2B1-4D5F-6A78-9B0C-1D2E3F4A5B6C">

			<UpgradeVersion
				Property="WIX_UPGRADE_DETECTED"
				Minimum="0.0.0"
				Maximum="$(var.Version)"
				IncludeMinimum="yes"
				IncludeMaximum="no" />

			<UpgradeVersion
				Property="SAME_VERSION_PRODUCT"
				Minimum="$(var.Version)"
				Maximum="$(var.Version)"
				IncludeMinimum="yes"
				IncludeMaximum="yes" />

			<UpgradeVersion
				Property="WIX_DOWNGRADE_DETECTED"
				Minimum="$(var.Version)"
				IncludeMinimum="no"
				OnlyDetect="yes" />

		</Upgrade>

		<!-- Only prevent actual downgrades. -->
		<Launch
			Condition="NOT WIX_DOWNGRADE_DETECTED"
			Message="A newer version of AssetBee Drone is already installed." />

		<MediaTemplate EmbedCab="yes" />

		<WixVariable
			Id="WixUILicenseRtf"
			Value="$(var.SourceDir)\License.rtf" />

		<!-- Runtime configuration -->
		<Property Id="ENDPOINT" Secure="yes" />
		<Property Id="BEARERTOKEN" Secure="yes" Hidden="yes" />
		<Property Id="APIKEY" Secure="yes" Hidden="yes" />

		<!-- Existing configuration -->
		<Property Id="BT_EXISTING" Secure="yes" Hidden="yes" />
		<Property Id="AK_EXISTING" Secure="yes" Hidden="yes" />

		<Property Id="EP_HKLM" Secure="yes">
			<RegistrySearch
				Id="ExistingEndpointHklm"
				Root="HKLM"
				Key="SOFTWARE\AssetBee\Drone"
				Name="Endpoint"
				Type="raw" />
		</Property>

		<Property Id="BT_HKLM" Secure="yes" Hidden="yes">
			<RegistrySearch
				Id="ExistingBearerHklm"
				Root="HKLM"
				Key="SOFTWARE\AssetBee\Drone"
				Name="BearerToken"
				Type="raw" />
		</Property>

		<Property Id="AK_HKLM" Secure="yes" Hidden="yes">
			<RegistrySearch
				Id="ExistingApiKeyHklm"
				Root="HKLM"
				Key="SOFTWARE\AssetBee\Drone"
				Name="ApiKey"
				Type="raw" />
		</Property>

		<Property Id="EP_HKCU" Secure="yes">
			<RegistrySearch
				Id="ExistingEndpointHkcu"
				Root="HKCU"
				Key="SOFTWARE\AssetBee\Drone"
				Name="Endpoint"
				Type="raw" />
		</Property>

		<Property Id="BT_HKCU" Secure="yes" Hidden="yes">
			<RegistrySearch
				Id="ExistingBearerHkcu"
				Root="HKCU"
				Key="SOFTWARE\AssetBee\Drone"
				Name="BearerToken"
				Type="raw" />
		</Property>

		<Property Id="AK_HKCU" Secure="yes" Hidden="yes">
			<RegistrySearch
				Id="ExistingApiKeyHkcu"
				Root="HKCU"
				Key="SOFTWARE\AssetBee\Drone"
				Name="ApiKey"
				Type="raw" />
		</Property>

		<Feature
			Id="Main"
			Title="AssetBee Drone"
			Level="1">

			<ComponentGroupRef Id="ProductComponents" />

		</Feature>

		<StandardDirectory Id="ProgramFiles64Folder">

			<Directory
				Id="AssetBeeFolder"
				Name="AssetBee">

				<Directory
					Id="INSTALLFOLDER"
					Name="Drone" />

			</Directory>

		</StandardDirectory>

		<ComponentGroup
			Id="ProductComponents"
			Directory="INSTALLFOLDER">

			<Component
				Id="InstallFolderAcl"
				Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

				<CreateFolder>
					<util:PermissionEx
						User="SYSTEM"
						GenericAll="yes" />

					<util:PermissionEx
						User="Administrators"
						GenericAll="yes" />

					<util:PermissionEx
						User="Users"
						GenericRead="yes"
						GenericExecute="yes" />
				</CreateFolder>

				<RemoveFile
					Id="RemoveAppSettings"
					Name="appsettings.json"
					On="uninstall" />

				<RemoveRegistryKey
					Root="HKLM"
					Key="SOFTWARE\AssetBee\Drone"
					Action="removeOnUninstall" />

				<RemoveRegistryKey
					Root="HKCU"
					Key="SOFTWARE\AssetBee\Drone"
					Action="removeOnUninstall" />

			</Component>

			<Component
				Id="DroneBinary"
				Guid="B1C2D3E4-F5A6-7890-1234-56789ABCDEF0">

				<File
					Id="DroneExe"
					Source="$(var.PublishDir)\AssetBee.Drone.exe"
					KeyPath="yes" />

				<ServiceInstall
					Id="AssetBeeDroneService"
					Name="AssetBeeDrone"
					DisplayName="AssetBee Drone"
					Description="Collects and securely reports device inventory."
					Type="ownProcess"
					Start="auto"
					Account="LocalSystem"
					ErrorControl="normal"
					Vital="yes" />

				<ServiceControl
					Id="StartAssetBeeDroneService"
					Name="AssetBeeDrone"
					Start="install"
					Stop="both"
					Remove="uninstall"
					Wait="yes" />

				<util:ServiceConfig
					ServiceName="AssetBeeDrone"
					FirstFailureActionType="restart"
					SecondFailureActionType="restart"
					ThirdFailureActionType="restart"
					RestartServiceDelayInSeconds="15"
					ResetPeriodInDays="1" />

			</Component>

			<Component
				Id="TrayBinary"
				Guid="E4F5A6B7-C8D9-0123-4567-89ABCDEF0123">

				<File
					Id="TrayExe"
					Source="$(var.PublishDir)\AssetBee.Drone.Tray.exe"
					KeyPath="yes" />

				<RegistryValue
					Root="HKLM"
					Key="Software\Microsoft\Windows\CurrentVersion\Run"
					Name="AssetBeeDroneTray"
					Type="string"
					Value="&quot;[#TrayExe]&quot;" />

			</Component>

			<Component
				Id="WriteAppSettingsScript"
				Guid="C2D3E4F5-A6B7-8901-2345-6789ABCDEF01">

				<File
					Id="WriteAppSettingsPs1"
					Source="$(var.SourceDir)\WriteAppSettings.ps1"
					KeyPath="yes" />

			</Component>

		</ComponentGroup>

		<UIRef Id="AssetBeeDroneUI" />

		<!-- WiX Util custom actions -->

		<CustomAction
			Id="ExtractMsiScripts"
			BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
			DllEntry="WixQuietExec"
			Execute="immediate"
			Impersonate="yes"
			Return="check" />

		<CustomAction
			Id="ExtractMsiScriptsElevated"
			BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
			DllEntry="WixQuietExec"
			Execute="immediate"
			Impersonate="no"
			Return="check" />

		<CustomAction
			Id="LoadExistingSettings"
			BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
			DllEntry="WixQuietExec"
			Execute="immediate"
			Impersonate="yes"
			Return="ignore" />

		<CustomAction
			Id="PreserveExistingSettings"
			BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
			DllEntry="WixQuietExec"
			Execute="immediate"
			Impersonate="no"
			Return="ignore" />

		<CustomAction
			Id="SavePendingSettings"
			BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
			DllEntry="WixQuietExec"
			Execute="immediate"
			Impersonate="yes"
			Return="check" />

		<CustomAction
			Id="UninstallSameVersion"
			BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
			DllEntry="WixQuietExec"
			Execute="immediate"
			Impersonate="no"
			Return="check" />

		<!-- Copy AppSearch values into the primary MSI properties -->

		<CustomAction
			Id="SetEndpointFromHklm"
			Property="ENDPOINT"
			Value="[EP_HKLM]" />

		<CustomAction
			Id="SetEndpointFromHkcu"
			Property="ENDPOINT"
			Value="[EP_HKCU]" />

		<CustomAction
			Id="SetBearerExistingFromHklm"
			Property="BT_EXISTING"
			Value="[BT_HKLM]" />

		<CustomAction
			Id="SetBearerExistingFromHkcu"
			Property="BT_EXISTING"
			Value="[BT_HKCU]" />

		<CustomAction
			Id="SetApiKeyExistingFromHklm"
			Property="AK_EXISTING"
			Value="[AK_HKLM]" />

		<CustomAction
			Id="SetApiKeyExistingFromHkcu"
			Property="AK_EXISTING"
			Value="[AK_HKCU]" />

		<CustomAction
			Id="RestoreBearerOnly"
			Property="BEARERTOKEN"
			Value="[BT_EXISTING]" />

		<CustomAction
			Id="RestoreApiKeyOnly"
			Property="APIKEY"
			Value="[AK_EXISTING]" />

		<CustomAction
			Id="RestoreBearerPrefer"
			Property="BEARERTOKEN"
			Value="[BT_EXISTING]" />

		<!-- Existing helper-script SetProperty declarations stay unchanged here. -->

		<SetProperty
			Id="WixQuietExecCmdLine"
			Action="SetExtractMsiScriptsUI"
			Sequence="ui"
			Before="ExtractMsiScripts"
			Condition="NOT REMOVE"
			Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$d=$env:TEMP; $c=Join-Path $env:SystemRoot 'System32\certutil.exe'; Set-Content -LiteralPath (Join-Path $d 'ab-sp.b64') -Value '$(var.SavePendingB64)' -Encoding Ascii; &amp; $c -f -decode (Join-Path $d 'ab-sp.b64') (Join-Path $d 'AssetBee-SavePending.ps1') | Out-Null; Set-Content -LiteralPath (Join-Path $d 'ab-le.b64') -Value '$(var.LoadExistingB64)' -Encoding Ascii; &amp; $c -f -decode (Join-Path $d 'ab-le.b64') (Join-Path $d 'AssetBee-LoadExisting.ps1') | Out-Null; Set-Content -LiteralPath (Join-Path $d 'ab-ps.b64') -Value '$(var.PreserveSettingsB64)' -Encoding Ascii; &amp; $c -f -decode (Join-Path $d 'ab-ps.b64') (Join-Path $d 'AssetBee-PreserveSettings.ps1') | Out-Null; exit 0&quot;" />

		<SetProperty
			Id="WixQuietExecCmdLine"
			Action="SetExtractMsiScriptsElevated"
			Sequence="execute"
			Before="ExtractMsiScriptsElevated"
			Condition="NOT REMOVE"
			Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$d=Join-Path $env:ProgramData 'AssetBee\Drone\msi-scripts'; New-Item -ItemType Directory -Force -Path $d | Out-Null; $c=Join-Path $env:SystemRoot 'System32\certutil.exe'; Set-Content -LiteralPath (Join-Path $d 'ab-sp.b64') -Value '$(var.SavePendingB64)' -Encoding Ascii; &amp; $c -f -decode (Join-Path $d 'ab-sp.b64') (Join-Path $d 'AssetBee-SavePending.ps1') | Out-Null; Set-Content -LiteralPath (Join-Path $d 'ab-le.b64') -Value '$(var.LoadExistingB64)' -Encoding Ascii; &amp; $c -f -decode (Join-Path $d 'ab-le.b64') (Join-Path $d 'AssetBee-LoadExisting.ps1') | Out-Null; Set-Content -LiteralPath (Join-Path $d 'ab-ps.b64') -Value '$(var.PreserveSettingsB64)' -Encoding Ascii; &amp; $c -f -decode (Join-Path $d 'ab-ps.b64') (Join-Path $d 'AssetBee-PreserveSettings.ps1') | Out-Null; exit 0&quot;" />

		<SetProperty
			Id="WixQuietExecCmdLine"
			Action="SetLoadExistingSettingsUI"
			Sequence="ui"
			Before="LoadExistingSettings"
			Condition="NOT REMOVE"
			Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[TempFolder]AssetBee-LoadExisting.ps1&quot;" />

		<SetProperty
			Id="WixQuietExecCmdLine"
			Action="SetLoadExistingSettingsExec"
			Sequence="execute"
			Before="LoadExistingSettings"
			Condition="NOT REMOVE"
			Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[CommonAppDataFolder]AssetBee\Drone\msi-scripts\AssetBee-LoadExisting.ps1&quot;" />

		<SetProperty
			Id="WixQuietExecCmdLine"
			Action="SetPreserveExistingSettings"
			Sequence="execute"
			Before="PreserveExistingSettings"
			Condition="(WIX_UPGRADE_DETECTED OR SAME_VERSION_PRODUCT) AND NOT REMOVE"
			Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[CommonAppDataFolder]AssetBee\Drone\msi-scripts\AssetBee-PreserveSettings.ps1&quot;" />

		<SetProperty
			Id="WriteAppSettings"
			Sequence="execute"
			Before="WriteAppSettings"
			Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]WriteAppSettings.ps1&quot; -Endpoint &quot;[ENDPOINT]&quot; -BearerToken &quot;[BEARERTOKEN]&quot; -ApiKey &quot;[APIKEY]&quot; -InstallDir &quot;[INSTALLFOLDER].&quot;" />

		<CustomAction
			Id="WriteAppSettings"
			BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
			DllEntry="WixQuietExec"
			Execute="deferred"
			Impersonate="no"
			Return="check" />

		<CustomAction
			Id="LaunchTray"
			FileRef="TrayExe"
			ExeCommand=""
			Execute="immediate"
			Impersonate="yes"
			Return="asyncNoWait" />

		<InstallUISequence>

			<Custom
				Action="ExtractMsiScripts"
				Before="AppSearch"
				Condition="NOT REMOVE" />

			<Custom
				Action="SetEndpointFromHklm"
				After="AppSearch"
				Condition="NOT ENDPOINT AND EP_HKLM" />

			<Custom
				Action="SetEndpointFromHkcu"
				After="SetEndpointFromHklm"
				Condition="NOT ENDPOINT AND EP_HKCU" />

			<Custom
				Action="SetBearerExistingFromHklm"
				After="AppSearch"
				Condition="NOT BT_EXISTING AND BT_HKLM" />

			<Custom
				Action="SetBearerExistingFromHkcu"
				After="SetBearerExistingFromHklm"
				Condition="NOT BT_EXISTING AND BT_HKCU" />

			<Custom
				Action="SetApiKeyExistingFromHklm"
				After="AppSearch"
				Condition="NOT AK_EXISTING AND AK_HKLM" />

			<Custom
				Action="SetApiKeyExistingFromHkcu"
				After="SetApiKeyExistingFromHklm"
				Condition="NOT AK_EXISTING AND AK_HKCU" />

			<Custom
				Action="LoadExistingSettings"
				After="SetApiKeyExistingFromHkcu"
				Condition="NOT REMOVE" />

		</InstallUISequence>

		<InstallExecuteSequence>

			<Custom
				Action="ExtractMsiScriptsElevated"
				Before="AppSearch"
				Condition="NOT REMOVE" />

			<Custom
				Action="SetEndpointFromHklm"
				After="AppSearch"
				Condition="NOT ENDPOINT AND EP_HKLM" />

			<Custom
				Action="SetEndpointFromHkcu"
				After="SetEndpointFromHklm"
				Condition="NOT ENDPOINT AND EP_HKCU" />

			<Custom
				Action="SetBearerExistingFromHklm"
				After="AppSearch"
				Condition="NOT BT_EXISTING AND BT_HKLM" />

			<Custom
				Action="SetBearerExistingFromHkcu"
				After="SetBearerExistingFromHklm"
				Condition="NOT BT_EXISTING AND BT_HKCU" />

			<Custom
				Action="SetApiKeyExistingFromHklm"
				After="AppSearch"
				Condition="NOT AK_EXISTING AND AK_HKLM" />

			<Custom
				Action="SetApiKeyExistingFromHkcu"
				After="SetApiKeyExistingFromHklm"
				Condition="NOT AK_EXISTING AND AK_HKCU" />

			<Custom
				Action="LoadExistingSettings"
				After="SetApiKeyExistingFromHkcu"
				Condition="NOT REMOVE" />

			<Custom
				Action="RestoreBearerOnly"
				After="LoadExistingSettings"
				Condition="NOT BEARERTOKEN AND NOT APIKEY AND BT_EXISTING AND NOT AK_EXISTING AND NOT REMOVE" />

			<Custom
				Action="RestoreApiKeyOnly"
				After="RestoreBearerOnly"
				Condition="NOT BEARERTOKEN AND NOT APIKEY AND AK_EXISTING AND NOT REMOVE" />

			<Custom
				Action="RestoreBearerPrefer"
				After="RestoreApiKeyOnly"
				Condition="NOT BEARERTOKEN AND NOT APIKEY AND BT_EXISTING AND NOT REMOVE" />

			<Custom
				Action="PreserveExistingSettings"
				After="InstallInitialize"
				Condition="(WIX_UPGRADE_DETECTED OR SAME_VERSION_PRODUCT) AND NOT REMOVE" />

			<RemoveExistingProducts
				After="PreserveExistingSettings" />

			<Custom
				Action="WriteAppSettings"
				Before="StartServices"
				Condition="NOT REMOVE" />

			<Custom
				Action="LaunchTray"
				After="InstallFinalize"
				Condition="NOT REMOVE" />

		</InstallExecuteSequence>

	</Package>

</Wix>