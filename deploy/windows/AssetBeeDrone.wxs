<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="AssetBee Drone"
      Manufacturer="AssetBee"
      Version="$(var.Version)"
      UpgradeCode="A7E3C2B1-4D5F-6A78-9B0C-1D2E3F4A5B6C"
      Scope="perMachine"
      Language="1033">
    <!-- Older → upgrade in place; same version → detect for UI choice; newer → block. -->
    <Upgrade Id="A7E3C2B1-4D5F-6A78-9B0C-1D2E3F4A5B6C">
      <UpgradeVersion
          Property="WIX_UPGRADE_DETECTED"
          Minimum="0.0.0"
          Maximum="$(var.Version)"
          IncludeMinimum="yes"
          IncludeMaximum="no" />
      <UpgradeVersion
          Property="SAME_VERSION_PRODUCT"
          Minimum="$(var.Version)"
          Maximum="$(var.Version)"
          IncludeMinimum="yes"
          IncludeMaximum="yes" />
      <UpgradeVersion
          Property="WIX_DOWNGRADE_DETECTED"
          Minimum="$(var.Version)"
          IncludeMinimum="no"
          OnlyDetect="yes" />
    </Upgrade>

    <Launch
        Condition="NOT WIX_DOWNGRADE_DETECTED"
        Message="A newer version of AssetBee Drone is already installed." />

    <MediaTemplate EmbedCab="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\License.rtf" />

    <!-- Public + Secure: command-line and (when the OS allows) UI → elevated execute. -->
    <Property Id="ENDPOINT" Secure="yes" />
    <Property Id="BEARERTOKEN" Secure="yes" Hidden="yes" />
    <Property Id="APIKEY" Secure="yes" Hidden="yes" />
    <Property Id="BT_EXISTING" Secure="yes" Hidden="yes" />
    <Property Id="AK_EXISTING" Secure="yes" Hidden="yes" />

    <Property Id="EP_HKLM" Secure="yes">
      <RegistrySearch
          Id="ExistingEndpointHklm"
          Root="HKLM"
          Key="SOFTWARE\AssetBee\Drone"
          Name="Endpoint"
          Type="raw" />
    </Property>
    <Property Id="BT_HKLM" Secure="yes" Hidden="yes">
      <RegistrySearch
          Id="ExistingBearerHklm"
          Root="HKLM"
          Key="SOFTWARE\AssetBee\Drone"
          Name="BearerToken"
          Type="raw" />
    </Property>
    <Property Id="AK_HKLM" Secure="yes" Hidden="yes">
      <RegistrySearch
          Id="ExistingApiKeyHklm"
          Root="HKLM"
          Key="SOFTWARE\AssetBee\Drone"
          Name="ApiKey"
          Type="raw" />
    </Property>

    <Property Id="EP_HKCU" Secure="yes">
      <RegistrySearch
          Id="ExistingEndpointHkcu"
          Root="HKCU"
          Key="SOFTWARE\AssetBee\Drone"
          Name="Endpoint"
          Type="raw" />
    </Property>
    <Property Id="BT_HKCU" Secure="yes" Hidden="yes">
      <RegistrySearch
          Id="ExistingBearerHkcu"
          Root="HKCU"
          Key="SOFTWARE\AssetBee\Drone"
          Name="BearerToken"
          Type="raw" />
    </Property>
    <Property Id="AK_HKCU" Secure="yes" Hidden="yes">
      <RegistrySearch
          Id="ExistingApiKeyHkcu"
          Root="HKCU"
          Key="SOFTWARE\AssetBee\Drone"
          Name="ApiKey"
          Type="raw" />
    </Property>

    <Feature Id="Main" Title="AssetBee Drone" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="AssetBeeFolder" Name="AssetBee">
        <Directory Id="INSTALLFOLDER" Name="Drone" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="InstallFolderAcl" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
        <CreateFolder>
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
          <util:PermissionEx User="Administrators" GenericAll="yes" />
          <util:PermissionEx User="Users" GenericRead="yes" GenericExecute="yes" />
        </CreateFolder>
        <RemoveFile Id="RemoveAppSettings" Name="appsettings.json" On="uninstall" />
        <RemoveRegistryKey Root="HKLM" Key="SOFTWARE\AssetBee\Drone" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="SOFTWARE\AssetBee\Drone" Action="removeOnUninstall" />
      </Component>

      <Component Id="DroneBinary" Guid="B1C2D3E4-F5A6-7890-1234-56789ABCDEF0">
        <File Id="DroneExe" Source="$(var.PublishDir)\AssetBee.Drone.exe" KeyPath="yes" />
        <ServiceInstall
            Id="AssetBeeDroneService"
            Name="AssetBeeDrone"
            DisplayName="AssetBee Drone"
            Description="Collects and securely reports device inventory."
            Type="ownProcess"
            Start="auto"
            Account="LocalSystem"
            ErrorControl="normal"
            Vital="yes" />
        <ServiceControl
            Id="StartAssetBeeDroneService"
            Name="AssetBeeDrone"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
        <util:ServiceConfig
            ServiceName="AssetBeeDrone"
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
            RestartServiceDelayInSeconds="15"
            ResetPeriodInDays="1" />
      </Component>

      <Component Id="TrayBinary" Guid="E4F5A6B7-C8D9-0123-4567-89ABCDEF0123">
        <File Id="TrayExe" Source="$(var.PublishDir)\AssetBee.Drone.Tray.exe" KeyPath="yes" />
        <RegistryValue
            Root="HKLM"
            Key="Software\Microsoft\Windows\CurrentVersion\Run"
            Name="AssetBeeDroneTray"
            Type="string"
            Value="&quot;[#TrayExe]&quot;" />
      </Component>

      <Component Id="WriteAppSettingsScript" Guid="C2D3E4F5-A6B7-8901-2345-6789ABCDEF01">
        <File Id="WriteAppSettingsPs1" Source="$(var.SourceDir)\WriteAppSettings.ps1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <UIRef Id="AssetBeeDroneUI" />

    <SetProperty
        Id="LoadExistingSettings"
        Sequence="first"
        Before="LoadExistingSettings"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$p = Join-Path $env:ProgramFiles 'AssetBee\Drone\appsettings.json'; if (-not (Test-Path -LiteralPath $p)) { exit 0 }; $j = Get-Content -LiteralPath $p -Raw | ConvertFrom-Json; if ($null -eq $j.Drone) { exit 0 }; $ep = [string]$j.Drone.Endpoint; $b = [string]$j.Drone.BearerToken; $a = [string]$j.Drone.ApiKey; function W($r) { New-Item -Path $r -Force | Out-Null; if ($ep) { Set-ItemProperty -Path $r -Name Endpoint -Value $ep }; if (-not [string]::IsNullOrWhiteSpace($b) -and $b -ne 'null') { Set-ItemProperty -Path $r -Name BearerToken -Value $b } else { Remove-ItemProperty -Path $r -Name BearerToken -EA SilentlyContinue }; if (-not [string]::IsNullOrWhiteSpace($a) -and $a -ne 'null') { Set-ItemProperty -Path $r -Name ApiKey -Value $a } else { Remove-ItemProperty -Path $r -Name ApiKey -EA SilentlyContinue } }; foreach ($r in @('HKLM:\SOFTWARE\AssetBee\Drone','HKCU:\SOFTWARE\AssetBee\Drone')) { try { W $r } catch {} }&quot;" />

    <CustomAction
        Id="LoadExistingSettings"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="immediate"
        Impersonate="yes"
        Return="ignore" />

    <CustomAction Id="SetEndpointFromHklm" Property="ENDPOINT" Value="[EP_HKLM]" />
    <CustomAction Id="SetEndpointFromHkcu" Property="ENDPOINT" Value="[EP_HKCU]" />
    <CustomAction Id="SetBearerExistingFromHklm" Property="BT_EXISTING" Value="[BT_HKLM]" />
    <CustomAction Id="SetBearerExistingFromHkcu" Property="BT_EXISTING" Value="[BT_HKCU]" />
    <CustomAction Id="SetApiKeyExistingFromHklm" Property="AK_EXISTING" Value="[AK_HKLM]" />
    <CustomAction Id="SetApiKeyExistingFromHkcu" Property="AK_EXISTING" Value="[AK_HKCU]" />

    <CustomAction Id="RestoreBearerOnly" Property="BEARERTOKEN" Value="[BT_EXISTING]" />
    <CustomAction Id="RestoreApiKeyOnly" Property="APIKEY" Value="[AK_EXISTING]" />
    <CustomAction Id="RestoreBearerPrefer" Property="BEARERTOKEN" Value="[BT_EXISTING]" />

    <SetProperty
        Id="ExtractSavePendingScript"
        Sequence="ui"
        Before="ExtractSavePendingScript"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;[IO.File]::WriteAllBytes(([IO.Path]::Combine('[TempFolder]','AssetBee-SavePending.ps1')), [Convert]::FromBase64String('$(var.SavePendingB64)'))&quot;" />

    <CustomAction
        Id="ExtractSavePendingScript"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="immediate"
        Impersonate="yes"
        Return="ignore" />

    <!-- Before RemoveExistingProducts deletes appsettings.json, copy it to ProgramData for WriteAppSettings. -->
    <SetProperty
        Id="PreserveExistingSettings"
        Sequence="execute"
        Before="PreserveExistingSettings"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;[IO.File]::WriteAllBytes(([IO.Path]::Combine('[TempFolder]','AssetBee-PreserveSettings.ps1')), [Convert]::FromBase64String('$(var.PreserveSettingsB64)')); &amp; ([IO.Path]::Combine('[TempFolder]','AssetBee-PreserveSettings.ps1'))&quot;" />

    <CustomAction
        Id="PreserveExistingSettings"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="immediate"
        Impersonate="no"
        Return="ignore" />

    <CustomAction
        Id="SavePendingSettings"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="immediate"
        Impersonate="yes"
        Return="check" />

    <!-- Uninstall the already-installed same version (product code(s) from FindRelatedProducts). -->
    <CustomAction
        Id="UninstallSameVersion"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="immediate"
        Impersonate="no"
        Return="check" />

    <SetProperty
        Id="WriteAppSettings"
        Sequence="execute"
        Before="WriteAppSettings"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]WriteAppSettings.ps1&quot; -Endpoint &quot;[ENDPOINT]&quot; -BearerToken &quot;[BEARERTOKEN]&quot; -ApiKey &quot;[APIKEY]&quot; -InstallDir &quot;[INSTALLFOLDER].&quot;" />

    <CustomAction
        Id="WriteAppSettings"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <CustomAction
        Id="LaunchTray"
        FileRef="TrayExe"
        ExeCommand=""
        Execute="immediate"
        Impersonate="yes"
        Return="asyncNoWait" />

    <InstallUISequence>
      <Custom Action="ExtractSavePendingScript" After="AppSearch" Condition="NOT REMOVE AND NOT WIX_UPGRADE_DETECTED AND NOT SAME_VERSION_PRODUCT" />
      <Custom Action="LoadExistingSettings" Before="AppSearch" Condition="NOT REMOVE" />
      <Custom Action="SetEndpointFromHklm" After="AppSearch" Condition="NOT ENDPOINT AND EP_HKLM" />
      <Custom Action="SetEndpointFromHkcu" After="SetEndpointFromHklm" Condition="NOT ENDPOINT AND EP_HKCU" />
      <Custom Action="SetBearerExistingFromHklm" After="AppSearch" Condition="NOT BT_EXISTING AND BT_HKLM" />
      <Custom Action="SetBearerExistingFromHkcu" After="SetBearerExistingFromHklm" Condition="NOT BT_EXISTING AND BT_HKCU" />
      <Custom Action="SetApiKeyExistingFromHklm" After="AppSearch" Condition="NOT AK_EXISTING AND AK_HKLM" />
      <Custom Action="SetApiKeyExistingFromHkcu" After="SetApiKeyExistingFromHklm" Condition="NOT AK_EXISTING AND AK_HKCU" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <!-- Snapshot config before the old product uninstall deletes appsettings.json. -->
      <Custom
          Action="PreserveExistingSettings"
          After="InstallInitialize"
          Condition="(WIX_UPGRADE_DETECTED OR SAME_VERSION_PRODUCT) AND NOT REMOVE" />
      <RemoveExistingProducts After="PreserveExistingSettings" />
      <Custom Action="LoadExistingSettings" Before="AppSearch" Condition="NOT REMOVE" />
      <Custom Action="SetEndpointFromHklm" After="AppSearch" Condition="NOT ENDPOINT AND EP_HKLM" />
      <Custom Action="SetEndpointFromHkcu" After="SetEndpointFromHklm" Condition="NOT ENDPOINT AND EP_HKCU" />
      <Custom Action="SetBearerExistingFromHklm" After="AppSearch" Condition="NOT BT_EXISTING AND BT_HKLM" />
      <Custom Action="SetBearerExistingFromHkcu" After="SetBearerExistingFromHklm" Condition="NOT BT_EXISTING AND BT_HKCU" />
      <Custom Action="SetApiKeyExistingFromHklm" After="AppSearch" Condition="NOT AK_EXISTING AND AK_HKLM" />
      <Custom Action="SetApiKeyExistingFromHkcu" After="SetApiKeyExistingFromHklm" Condition="NOT AK_EXISTING AND AK_HKCU" />
      <Custom Action="RestoreBearerOnly" After="SetApiKeyExistingFromHkcu" Condition="NOT BEARERTOKEN AND NOT APIKEY AND BT_EXISTING AND NOT AK_EXISTING AND NOT REMOVE" />
      <Custom Action="RestoreApiKeyOnly" After="RestoreBearerOnly" Condition="NOT BEARERTOKEN AND NOT APIKEY AND AK_EXISTING AND NOT REMOVE" />
      <Custom Action="RestoreBearerPrefer" After="RestoreApiKeyOnly" Condition="NOT BEARERTOKEN AND NOT APIKEY AND BT_EXISTING AND NOT REMOVE" />
      <!-- Fresh: UI pending. Upgrade/reinstall: pending from PreserveExistingSettings. -->
      <Custom
          Action="WriteAppSettings"
          Before="StartServices"
          Condition="NOT REMOVE" />
      <Custom
          Action="LaunchTray"
          After="InstallFinalize"
          Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
