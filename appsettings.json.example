{
  "Drone": {
    "Endpoint": "http://assets.mysite.com/api/v1/inventory",
    "CollectionIntervalMinutes": 3600,
    "RequestTimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "BearerToken": "abk_MyKey",
    "ApiKey": null,
    "Type": null,
    "Debug": false,
    "DebugOutputPath": "inventory-debug.json",
    "IncludeSbom": true,
    "IncludeContainerSboms": true,
    "AutoUpdate": true,
    "AutoUpdateIntervalHours": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
