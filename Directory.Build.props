<Project>
  <PropertyGroup>
    <!-- Overridden by CI / packaging via -p:Version=... -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(Version)</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(Version)</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>

    <!-- PE/version resources: consistent publisher identity reduces AV/SmartScreen noise. -->
    <Company>AssetBee</Company>
    <Product>AssetBee Drone</Product>
    <Authors>AssetBee</Authors>
    <Copyright>Copyright (c) AssetBee</Copyright>
    <Description>Collects and securely reports device inventory.</Description>

    <!--
      Full URL of the auto-update manifest (typically .../latest.json).
      Empty disables auto-update. Override at publish: -p:UpdateFeedUrl=https://...
    -->
    <UpdateFeedUrl Condition="'$(UpdateFeedUrl)' == ''"></UpdateFeedUrl>
  </PropertyGroup>
</Project>
