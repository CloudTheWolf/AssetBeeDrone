<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>AssetBee.Drone</AssemblyName>
    <RootNamespace>AssetBeeDrone</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <DefaultItemExcludes>$(DefaultItemExcludes);AssetBeeDrone.Tests/**;AssetBeeDrone.Tray/**;AssetBeeDrone.MsiHelper/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AssetBeeDrone.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
  </ItemGroup>

  <!-- Bake UpdateFeedUrl into the binary for Native AOT (no runtime reflection). -->
  <Target Name="GenerateBuildConstants"
          BeforeTargets="BeforeCompile;CoreCompile"
          DependsOnTargets="PrepareForBuild">
    <PropertyGroup>
      <_BuildConstantsPath>$(IntermediateOutputPath)BuildConstants.g.cs</_BuildConstantsPath>
      <_EscapedUpdateFeedUrl>$([System.String]::Copy('$(UpdateFeedUrl)').Replace('\', '\\').Replace('"', '\"'))</_EscapedUpdateFeedUrl>
    </PropertyGroup>
    <!-- WriteLinesToFile splits on ';' — encode as %3B. One item per output line. -->
    <ItemGroup>
      <_BuildConstantsLine Include="// &lt;auto-generated /&gt;" />
      <_BuildConstantsLine Include="namespace AssetBeeDrone.Updating%3B" />
      <_BuildConstantsLine Include="internal static class BuildConstants" />
      <_BuildConstantsLine Include="{" />
      <_BuildConstantsLine Include="    public const string UpdateFeedUrl = &quot;$(_EscapedUpdateFeedUrl)&quot;%3B" />
      <_BuildConstantsLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(_BuildConstantsPath)"
      Lines="@(_BuildConstantsLine)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BuildConstantsPath)" KeepDuplicates="false" />
      <FileWrites Include="$(_BuildConstantsPath)" />
    </ItemGroup>
  </Target>

  <!--
    .NET 10 Native AOT Apple crypto (Network.framework / Swift) must link against the
    active Xcode macOS SDK. Without -isysroot, clang uses an older system Network.framework
    and fails with undefined symbols (nw_framer_options_*_object_value, objc_msgSend$…).
  -->
  <Target Name="AddMacOsNativeAotSdkRoot"
          BeforeTargets="LinkNative"
          Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <Exec Command="xcrun --sdk macosx --show-sdk-path"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MacOsSdkPath" />
    </Exec>
    <Warning Text="'$(_MacOsSdkPath)' == ''"
             Text="Could not resolve macOS SDK via xcrun; Native AOT link may fail. Install/select a recent Xcode." />
    <ItemGroup Condition="'$(_MacOsSdkPath)' != ''">
      <LinkerArg Include="-isysroot" />
      <LinkerArg Include="$(_MacOsSdkPath)" />
      <LinkerArg Include="-L$(_MacOsSdkPath)/usr/lib/swift" />
    </ItemGroup>
    <Message Importance="High"
             Text="Native AOT macOS SDK: $(_MacOsSdkPath)"
             Condition="'$(_MacOsSdkPath)' != ''" />
  </Target>

</Project>
